# Copy to backend/.env for local development. Every variable is optional;
# the defaults shown here are what you get if it's unset. See
# app/config.py for the authoritative list.

# SQLAlchemy URL. Default is a SQLite file next to wherever uvicorn runs.
# DATABASE_URL=sqlite:///./smiley.db

# Create the demo accounts (alice/bob/carol/dave + hr_admin, all with
# password "password123") on an empty database. Handy for local dev and
# classroom demos - NEVER enable this in production.
SEED_DEMO_DATA=true

# Background activity simulator.
# SIMULATOR_ENABLED=true
# SIMULATOR_INTERVAL_SECONDS=4

# Login sessions expire after this many hours.
# SESSION_TTL_HOURS=12

# Brute-force protection: this many failed logins from one IP for one
# username locks that pair out for LOGIN_LOCKOUT_MINUTES.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# Only needed if the frontend is served from a different origin than the
# API (comma-separated). The Vite dev proxy and the production build are
# both same-origin, so this normally stays empty.
# CORS_ORIGINS=
